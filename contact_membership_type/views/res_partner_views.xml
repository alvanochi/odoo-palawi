<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_res_partner_form_member_type" model="ir.ui.view">
        <field name="name">res.partner.form.member.type</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet/notebook" position="inside">
                <page string="Membership" name="membership_page">
                    <group>
                        <group>
                            <field name="member_active"/>
                            <field name="member_type_id"/>
                        </group>
                        <group>
                            <field name="member_points"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <record id="view_res_partner_list_member_points" model="ir.ui.view">
        <field name="name">res.partner.list.member.points</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//list" position="inside">
                <field name="member_type_id" optional="show"/>
                <field name="member_points" optional="show"/>
            </xpath>
        </field>
    </record>
</odoo>
