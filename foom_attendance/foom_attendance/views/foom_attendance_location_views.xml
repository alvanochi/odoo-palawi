<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="foom_attendance_location_view_list" model="ir.ui.view">
        <field name="name">foom.attendance.location.list</field>
        <field name="model">foom.attendance.location</field>
        <field name="arch" type="xml">
            <list string="Lokasi Absensi">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code" optional="show"/>
                <field name="latitude" digits="[10,7]"/>
                <field name="longitude" digits="[10,7]"/>
                <field name="radius_m"/>
                <field name="geofence_policy"/>
                <field name="employee_count" string="Employee"/>
                <field name="company_id" groups="base.group_multi_company" optional="show"/>
            </list>
        </field>
    </record>

    <record id="foom_attendance_location_view_form" model="ir.ui.view">
        <field name="name">foom.attendance.location.form</field>
        <field name="model">foom.attendance.location</field>
        <field name="arch" type="xml">
            <form string="Lokasi Absensi">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_employees" type="object" class="oe_stat_button"
                                icon="fa-users">
                            <field name="employee_count" widget="statinfo" string="Employee"/>
                        </button>
                        <button name="action_open_map" type="object" class="oe_stat_button"
                                icon="fa-map-marker" string="Peta"
                                invisible="not latitude and not longitude"/>
                    </div>
                    <widget name="web_ribbon" title="Diarsipkan" bg_color="text-bg-danger"
                            invisible="active"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="mis. Kantor Pusat Jakarta"/></h1>
                    </div>
                    <group>
                        <group string="Identitas">
                            <field name="code"/>
                            <field name="address_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="active" invisible="1"/>
                        </group>
                        <group string="Geofence">
                            <field name="latitude" digits="[10,7]"/>
                            <field name="longitude" digits="[10,7]"/>
                            <field name="radius_m"/>
                            <field name="geofence_policy"/>
                            <field name="map_url" widget="url" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Shift" name="shifts">
                            <field name="shift_ids" readonly="1">
                                <list>
                                    <field name="name"/>
                                    <field name="time_from" widget="float_time"/>
                                    <field name="time_to" widget="float_time"/>
                                </list>
                            </field>
                        </page>
                        <page string="Catatan" name="note">
                            <field name="note" placeholder="Patokan, pintu masuk, dsb."/>
                        </page>
                    </notebook>
                    <div class="text-muted mt-2">
                        Ambil koordinat dari Google Maps: klik kanan titik lokasi &#8594;
                        angka pertama latitude, kedua longitude.
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="foom_attendance_location_view_search" model="ir.ui.view">
        <field name="name">foom.attendance.location.search</field>
        <field name="model">foom.attendance.location</field>
        <field name="arch" type="xml">
            <search string="Lokasi Absensi">
                <field name="name"/>
                <field name="code"/>
                <filter name="filter_block" string="Blokir di luar radius"
                        domain="[('geofence_policy', '=', 'block')]"/>
                <filter name="filter_off" string="Tidak dicek"
                        domain="[('geofence_policy', '=', 'off')]"/>
                <separator/>
                <filter name="filter_archived" string="Diarsipkan"
                        domain="[('active', '=', False)]"/>
                <group expand="0" string="Kelompokkan">
                    <filter name="group_policy" string="Kebijakan"
                            context="{'group_by': 'geofence_policy'}"/>
                    <filter name="group_company" string="Company"
                            context="{'group_by': 'company_id'}"
                            groups="base.group_multi_company"/>
                </group>
            </search>
        </field>
    </record>

    <record id="foom_attendance_location_action" model="ir.actions.act_window">
        <field name="name">Lokasi Absensi</field>
        <field name="res_model">foom.attendance.location</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Tambah lokasi kerja pertama</p>
            <p>Setiap lokasi punya titik koordinat dan radius. Clock in/out di luar
               radius bisa diblokir atau sekadar ditandai.</p>
        </field>
    </record>

</odoo>
