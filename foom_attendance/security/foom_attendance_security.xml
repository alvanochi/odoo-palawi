<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <record id="foom_attendance_location_company_rule" model="ir.rule">
            <field name="name">Lokasi Absensi: multi-company</field>
            <field name="model_id" ref="model_foom_attendance_location"/>
            <field name="global" eval="True"/>
            <field name="domain_force">
                ['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]
            </field>
        </record>

