<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="foom_attendance_roster_view_list" model="ir.ui.view">
        <field name="name">foom.attendance.roster.list</field>
        <field name="model">foom.attendance.roster</field>
        <field name="arch" type="xml">
            <list string="Roster" editable="bottom" multi_edit="1">
                <field name="date"/>
                <field name="employee_id"/>
                <field name="department_id" optional="show"/>
                <field name="shift_id"/>
                <field name="location_id"/>
                <field name="day_off"/>
                <field name="note" optional="hide"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="foom_attendance_roster_view_form" model="ir.ui.view">
        <field name="name">foom.attendance.roster.form</field>
        <field name="model">foom.attendance.roster</field>
        <field name="arch" type="xml">
            <form string="Roster">
                <sheet>
                    <group>
                        <group>
                            <field name="employee_id"/>
                            <field name="date"/>
                            <field name="day_off"/>
                        </group>
                        <group>
                            <field name="shift_id" required="not day_off"
                                   readonly="day_off"/>
                            <field name="location_id" readonly="day_off"
                                   options="{'no_create': True}"/>
                            <field name="note"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="foom_attendance_roster_view_search" model="ir.ui.view">
        <field name="name">foom.attendance.roster.search</field>
        <field name="model">foom.attendance.roster</field>
        <field name="arch" type="xml">
            <search string="Roster">
                <field name="employee_id"/>
                <field name="shift_id"/>
                <field name="location_id"/>
                <field name="department_id"/>
                <filter name="filter_today" string="Hari ini"
                        domain="[('date', '=', context_today().strftime('%Y-%m-%d'))]"/>
                <filter name="filter_future" string="Mulai hari ini"
                        domain="[('date', '&gt;=', context_today().strftime('%Y-%m-%d'))]"/>
                <separator/>
                <filter name="filter_day_off" string="Libur" domain="[('day_off', '=', True)]"/>
                <group expand="0" string="Kelompokkan">
                    <filter name="group_date" string="Tanggal" context="{'group_by': 'date'}"/>
                    <filter name="group_employee" string="Employee"
                            context="{'group_by': 'employee_id'}"/>
                    <filter name="group_shift" string="Shift" context="{'group_by': 'shift_id'}"/>
                    <filter name="group_location" string="Lokasi"
                            context="{'group_by': 'location_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="foom_attendance_roster_action" model="ir.actions.act_window">
        <field name="name">Roster</field>
        <field name="res_model">foom.attendance.roster</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_filter_future': 1, 'search_default_group_date': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Belum ada roster</p>
            <p>Isi jadwal shift harian per employee. Kalau kosong, sistem memakai
               Shift Default dari form employee.</p>
        </field>
    </record>

</odoo>
