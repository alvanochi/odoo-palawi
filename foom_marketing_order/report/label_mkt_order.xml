<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="report_mkt_label">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-set="partner"
                   t-value="doc.partner_id or (doc.move_lines and doc.move_lines[0].partner_id) or False"/>
                <t t-call="web.basic_layout">
                    <div>
                        <div class="company-logo">
                            <img t-att-src="image_data_uri(doc.company_id.logo)" style="max-height:30px;"
                                 align="left"/>
                        </div>
                        <table style="font-size:10px; margin-bottom: 20px; margin-bottom: 20px;" width="100%">
                            <tr>
                                <td style="width:10%;">Pengirim</td>
                                <td style="width:2%;">:</td>
                                <td style="width:38%;">FOOM LAB GLOBAL</td>
                            </tr>
                            <tr>
                                <td style="width:10%;">Penerima</td>
                                <td style="width:2%;">:</td>
                                <td style="width:38%;">
                                    <div t-if="doc.partner_name == 'SAMPLE EKSTERNAL'">
                                        <div>
                                            <span t-esc="doc.name_tujuan"/>
                                        </div>
                                        <div>
                                            <span t-esc="doc.street"/>
                                        </div>
                                        <div>
                                            <span t-esc="doc.kecamatan"/>
                                        </div>
                                        <div>
                                            <span t-esc="doc.city"/>
                                            <span t-esc="doc.zip"/>
                                        </div>
                                        <div>
                                            <span t-esc="doc.state_id.name"/>
                                        </div>
                                        <div>
                                            <span t-esc="doc.mobile"/>
                                        </div>
                                        <br/>
                                        <br/>
                                    </div>
                                    <div t-if="doc.partner_name != 'SAMPLE EKSTERNAL'" name="partner_header">
                                        <div t-field="partner.commercial_partner_id"
                                             t-options='{"widget": "contact", "fields": ["address", "name", "phone"], "no_marker": True, "phone_icons": True}'/>
                                        <p t-if="partner.sudo().commercial_partner_id.vat"><t
                                                t-esc="doc.company_id.country_id.vat_label or 'Tax ID'"/>:
                                            <span t-field="partner.sudo().commercial_partner_id.vat"/>
                                        </p>
                                    </div>
                                </td>
                            </tr>
                        </table>

                        <table class="table table-sm table-bordered"
                               style="table-layout: fixed; border: 1px solid; text-align: center; font-weight: bold; font-size: 10px;">
                            <thead>
                                <th style="text-align: center; width:20%; font-weight: bold; font-size: 10px; border: 1px solid;">
                                    <p>No</p>
                                </th>
                                <th style="text-align: center; width:100%; font-weight: bold; font-size: 10px; border: 1px solid;">
                                    <p>Nama Produk</p>
                                </th>
                                <th style="text-align: center; width:50%; font-weight: bold; font-size: 10px; border: 1px solid;">
                                    <p>Varian</p>
                                </th>
                                <th style="text-align: center; width:40%; font-weight: bold; font-size: 10px; border: 1px solid;">
                                    <p>Qty</p>
                                </th>
                            </thead>
 +                           <tbody>
                                <t t-set="i" t-value="1"/>
                                <t t-foreach="doc.move_ids_without_package" t-as="line">
                                    <tr style="font-size: 10px; ">
                                        <td style="text-align: center; width:20%; font-weight: bold; font-size: 10px; border: 1px solid;">
                                            <span t-esc="i"/>
                                        </td>
                                        <td style="text-align: left; width:20%; font-weight: bold; font-size: 10px; border: 1px solid;">
                                            <span t-esc="line.product_id.name"/>
                                        </td>
                                        <td style="text-align: center; width:20%; font-weight: bold; font-size: 10px; border: 1px solid;">
                                            <t t-foreach="line.product_id.product_template_variant_value_ids" t-as="var">
                                                <span t-esc="var.name"/>
                                            </t>
                                        </td>
                                        <td style="text-align: center; width:20%; font-weight: bold; font-size: 10px; border: 1px solid;">
                                            <span t-esc="line.quantity_done"/>
                                        </td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>
                        <table style="font-size:10px" width="100%">
                            <tr>
                                <td style="width:10%;">Catatan</td>
                                <td style="width:2%;">:</td>
                                <td style="width:38%;">
                                    <t t-if="doc.mkt_id.tujuan == 'GI'">
                                    Free Gift/Sample External - <span t-esc="doc.mkt_id.type_id.type"/>
                                    </t>
                                    <t t-if="doc.mkt_id.tujuan == 'EV'">
                                    Event - <span t-esc="doc.mkt_id.type_id.type"/>
                                    </t>
                                    <t t-if="doc.mkt_id.tujuan == 'HP'">
                                    Hampers - <span t-esc="doc.mkt_id.type_id.type"/>
                                    </t>
                                    <t t-if="doc.mkt_id.tujuan == 'SP'">
                                    Sample Internal - <span t-esc="doc.mkt_id.type_id.type"/>
                                    </t>
                                    <t t-if="doc.mkt_id.tujuan == 'SC'">
                                    Support Customer - <span t-esc="doc.mkt_id.type_id.type"/>
                                    </t>
                                    <t t-if="doc.mkt_id.tujuan == 'KOL'">
                                    KOL - <span t-esc="doc.mkt_id.type_id.type"/>
                                    </t>
                                    <t t-if="not doc.mkt_id.tujuan"/>
                                </td>
                            </tr>
                            <tr>
                                <td style="width:10%;">Delivery Date</td>
                                <td style="width:2%;">:</td>
                                <td style="width:38%;">
                                    <span t-esc="'' if(doc.date_done==False) else doc.date_done.strftime('%d %B %Y')"/>
                                </td>
                            </tr>
                            <tr>
                                <td style="width:10%;">MO Ref</td>
                                <td style="width:2%;">:</td>
                                <td style="width:38%;">
                                    <span t-esc="doc.origin"/>
                                </td>
                            </tr>
                        </table>
                    </div>
                </t>
            </t>
        </t>
    </template>

    <record id="paperformat_mkt_label" model="report.paperformat">
        <field name="name">Marketing Order Label</field>
        <field name="default" eval="True"/>
        <field name="format">custom</field>
        <field name="page_height">100</field>
        <field name="page_width">100</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">0</field>
        <field name="margin_bottom">0</field>
        <field name="margin_left">0</field>
        <field name="margin_right">0</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">0</field>
        <field name="dpi">90</field>
    </record>

    <record id="action_print_mkt_label" model="ir.actions.report">
        <field name="name">Marketing Order Label</field>
        <field name="model">stock.picking</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">foom_marketing_order.report_mkt_label</field>
        <field name="report_file">foom_marketing_order.report_mkt_label</field>
        <field name="print_report_name">"Marketing Order Label"</field>
        <field name="binding_model_id" ref="model_stock_picking"/>
        <field name="binding_type">report</field>
        <field name="paperformat_id" ref="paperformat_mkt_label"/>
    </record>

</odoo>
