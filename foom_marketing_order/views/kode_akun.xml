<odoo>
    <data>
        <!-- explicit list view definition -->

        <record id="analytic_acc_list_view_inherit" model="ir.ui.view">
            <field name="name">analytic.acc.inherited</field>
            <field name="model">account.analytic.account</field>
            <field name="inherit_id" ref="analytic.view_account_analytic_account_list"></field>
            <field name="arch" type="xml">
                <field name="partner_id" position="after">
                    <field name="tags"/>
                </field>
            </field>
        </record>

        <record id="analytic_acc_form_view_inherit" model="ir.ui.view">
            <field name="name">analytic.acc.form.inherited</field>
            <field name="model">account.analytic.account</field>
            <field name="inherit_id" ref="analytic.view_account_analytic_account_form"></field>
            <field name="arch" type="xml">
                <field name="currency_id" position="after">
                    <field name="tags"/>
                </field>
            </field>
        </record>


        <record id="action_analytic_account_form" model="ir.actions.act_window">
            <field name="name">Analytic Accounts</field>
            <field name="res_model">account.analytic.account</field>
            <field name="view_mode">list,kanban,form</field>
            <field name="search_view_id" ref="analytic.view_account_analytic_account_search"/>
            <field name="context">{'create':False,'edit':False, 'delete':False,}</field>
            <field name="domain">[('tags','=','MKT')]</field>
            <field name="view_id" ref="analytic.view_account_analytic_account_list"/>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Add a new analytic account
                </p>
            </field>
        </record>

        <menuitem
                id="foom_marketing_order_kode_akun"
                parent="foom_marketing_order.menu_root"
                action="foom_marketing_order.action_analytic_account_form"
                name="Analytic Account"
                sequence="40"
        />
    </data>
</odoo>