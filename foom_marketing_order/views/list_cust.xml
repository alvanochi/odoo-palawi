<odoo>
    <data>
        <!-- explicit list view definition -->
        <record id="view_marketing_order_cust_list" model="ir.ui.view">
            <field name="name">view.marketing.order.cust.list</field>
            <field name="model">marketing.order.cust</field>
            <field name="arch" type="xml">
                <list default_order='create_date desc'>
                    <field name="name"/>
                    <field name="type_id"/>
                    <field name="street"/>
                    <field name="kecamatan"/>
                    <field name="city"/>
                    <field name="state_id"/>
                    <field name="zip"/>
                    <field name="country_id" optional="show"/>
                    <field name="mobile"/>
                    <field name="store_id"/>
                </list>
            </field>
        </record>

        <record id="view_marketing_order_cust_form" model="ir.ui.view">
            <field name="name">view.marketing.order.cust.form</field>
            <field name="model">marketing.order.cust</field>
            <field name="arch" type="xml">
                <form duplicate="0">
                    <sheet>
                        <group>
                            <group>
                                <field name="name"/>
                                <field name="type_id" options="{'no_create': True}"/>
                                <field name="street"/>
                                <field name="store_id"/>
                            </group>
                            <group>
                                <field name="kecamatan"/>
                                <field name="city"/>
                                <field name="state_id" options="{'no_create': True}"/>
                                <field name="zip"/>
                                <field name="country_id" optional="show" options="{'no_create': True}"/>
                                <field name="mobile"/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- actions opening views on models -->
        <record model="ir.actions.act_window" id="action_marketing_order_cust">
            <field name="name">Customer</field>
            <field name="res_model">marketing.order.cust</field>
            <field name="view_mode">list,form</field>
        </record>

        <menuitem
                id="foom_marketing_order_cust"
                parent="foom_marketing_order.menu_root"
                action="action_marketing_order_cust"
                name="Customer"
                sequence="20"
        />

    </data>
</odoo>