<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="stock_warehouse_marketing_order_form" model="ir.ui.view">
        <field name="name">stock.warehouse.marketing.order.form</field>
        <field name="model">stock.warehouse</field>
        <field name="inherit_id" ref="stock.view_warehouse"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='delivery_steps']" position="after">
                <group string="Marketing Order">
                    <field name="is_marketing_order"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>