<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- Provinces -->
        <record id="view_kas_qris_province_list" model="ir.ui.view">
            <field name="name">kas.qris.province.list</field>
            <field name="model">kas.qris.province</field>
            <field name="arch" type="xml">
                <list>
                    <header>
                        <button name="action_sync_from_winpay" type="object" string="Sync from Winpay" class="btn-primary"/>
                    </header>
                    <field name="name"/>
                    <field name="code"/>
                </list>
            </field>
        </record>

        <record id="view_kas_qris_province_form" model="ir.ui.view">
            <field name="name">kas.qris.province.form</field>
