                <form>
                    <header>
                        <button name="action_sync_from_winpay" type="object" string="Sync from Winpay" class="btn-primary"/>
                    </header>
                    <sheet>
                        <group>
                            <field name="name"/>
                            <field name="code"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="action_kas_qris_province" model="ir.actions.act_window">
            <field name="name">Provinces</field>
            <field name="res_model">kas.qris.province</field>
