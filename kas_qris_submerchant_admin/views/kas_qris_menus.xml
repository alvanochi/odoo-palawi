<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ================= ACTIONS ================= -->

    <record id="action_kas_qris_submerchant" model="ir.actions.act_window">
        <field name="name">Submerchants</field>
        <field name="res_model">kas.qris.submerchant</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_kas_qris_province" model="ir.actions.act_window">
        <field name="name">Provinces</field>
        <field name="res_model">kas.qris.province</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_kas_qris_city" model="ir.actions.act_window">
        <field name="name">Cities</field>
        <field name="res_model">kas.qris.city</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_kas_qris_merchant_type" model="ir.actions.act_window">
        <field name="name">Merchant Types</field>
        <field name="res_model">kas.qris.merchant.type</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_kas_qris_merchant_criteria" model="ir.actions.act_window">
        <field name="name">Merchant Criteria</field>
        <field name="res_model">kas.qris.merchant.criteria</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_kas_qris_merchant_category" model="ir.actions.act_window">
        <field name="name">Merchant Categories (MCC)</field>
        <field name="res_model">kas.qris.merchant.category</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_kas_qris_bank_code" model="ir.actions.act_window">
        <field name="name">Bank Codes</field>
        <field name="res_model">kas.qris.bank.code</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- ================= MENUS ================= -->

    <!-- ROOT -->
    <menuitem id="menu_qris_root"
        name="QRIS Submerchant"
        sequence="10"/>

    <menuitem id="menu_qris_submerchant"
        name="Submerchants"
        parent="menu_qris_root"
        action="action_kas_qris_submerchant"
        sequence="10"/>

    <menuitem id="menu_qris_master"
        name="Master Data"
        parent="menu_qris_root"
        sequence="20"/>

    <menuitem id="menu_qris_master_province"
        name="Provinces"
        parent="menu_qris_master"
        action="action_kas_qris_province"
        sequence="10"/>

    <menuitem id="menu_qris_master_city"
        name="Cities"
        parent="menu_qris_master"
        action="action_kas_qris_city"
        sequence="20"/>

    <menuitem id="menu_qris_master_merchant_type"
        name="Merchant Types"
        parent="menu_qris_master"
        action="action_kas_qris_merchant_type"
        sequence="30"/>

    <menuitem id="menu_qris_master_merchant_criteria"
        name="Merchant Criteria"
        parent="menu_qris_master"
        action="action_kas_qris_merchant_criteria"
        sequence="40"/>

    <menuitem id="menu_qris_master_merchant_category"
        name="Merchant Categories (MCC)"
        parent="menu_qris_master"
        action="action_kas_qris_merchant_category"
        sequence="50"/>

    <menuitem id="menu_qris_master_bank_code"
        name="Bank Codes"
        parent="menu_qris_master"
        action="action_kas_qris_bank_code"
        sequence="60"/>

</odoo>
