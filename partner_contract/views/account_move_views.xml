<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- List view khusus untuk tagihan kontrak -->
    <record id="contract_invoice_view_list" model="ir.ui.view">
        <field name="name">contract.invoice.view.list</field>
        <field name="model">account.move</field>
        <field name="arch" type="xml">
            <list create="false" default_order="invoice_date desc">
                <field name="name"/>
                <field name="contract_id"/>
                <field name="partner_id"/>
                <field name="invoice_date"/>
                <field name="invoice_date_due" optional="show"/>
                <field name="amount_total" widget="monetary" sum="Total"/>
                <field name="amount_residual" widget="monetary"
                       sum="Sisa Tagihan"/>
                <field name="payment_state" widget="badge"
                       decoration-success="payment_state in ('paid', 'in_payment')"
                       decoration-warning="payment_state == 'partial'"
                       decoration-danger="payment_state == 'not_paid'"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'draft'"
                       decoration-success="state == 'posted'"/>
                <field name="currency_id" column_invisible="1"/>
            </list>
        </field>
    </record>

    <!-- Search view untuk tagihan kontrak -->
    <record id="contract_invoice_view_search" model="ir.ui.view">
        <field name="name">contract.invoice.view.search</field>
        <field name="model">account.move</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="partner_id"/>
                <field name="contract_id"/>
                <filter name="filter_not_paid" string="Belum Dibayar"
                        domain="[('payment_state', '=', 'not_paid')]"/>
                <filter name="filter_partial" string="Dibayar Sebagian"
                        domain="[('payment_state', '=', 'partial')]"/>
                <filter name="filter_paid" string="Lunas"
                        domain="[('payment_state', 'in', ('paid', 'in_payment'))]"/>
                <separator/>
                <filter name="filter_posted" string="Terposting"
                        domain="[('state', '=', 'posted')]"/>
                <filter name="filter_draft" string="Draft"
                        domain="[('state', '=', 'draft')]"/>
                <group expand="0" string="Group By">
                    <filter name="group_contract" string="Kontrak"
                            context="{'group_by': 'contract_id'}"/>
                    <filter name="group_partner" string="Mitra / Tenant"
                            context="{'group_by': 'partner_id'}"/>
                    <filter name="group_payment_state"
                            string="Status Pembayaran"
                            context="{'group_by': 'payment_state'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action: Tagihan Kontrak -->
    <record id="action_contract_invoices" model="ir.actions.act_window">
        <field name="name">Tagihan Kontrak</field>
        <field name="res_model">account.move</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="contract_invoice_view_list"/>
        <field name="search_view_id" ref="contract_invoice_view_search"/>
        <field name="domain">[('move_type', '=', 'out_invoice'),
                              ('contract_id', '!=', False)]</field>
        <field name="context">{'default_move_type': 'out_invoice',
                               'search_default_group_payment_state': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Belum ada tagihan kontrak
            </p>
            <p>
                Tagihan dibuat dari tombol "Buat Tagihan" pada kontrak,
                atau otomatis oleh penjadwal harian sesuai tanggal tagihan
                berikutnya.
            </p>
        </field>
    </record>

</odoo>
