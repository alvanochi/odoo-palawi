<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="group_pos_econique_manager" model="res.groups">
        <field name="name">Econique Integration Manager</field>
        <field name="category_id" ref="base.module_category_sales_point_of_sale"/>
        <field name="implied_ids" eval="[(4, ref('point_of_sale.group_pos_user'))]"/>
        <field name="comment">Can manage the Union Econique integration settings per POS config (including the API password), and see and resend Econique transactions.</field>
    </record>

    <record id="pos_econique_config_company_rule" model="ir.rule">
        <field name="name">Econique Config: multi-company</field>
        <field name="model_id" ref="model_pos_econique_config"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>

    <record id="pos_econique_payment_map_company_rule" model="ir.rule">
        <field name="name">Econique Payment Map: multi-company</field>
        <field name="model_id" ref="model_pos_econique_payment_map"/>
        <field name="domain_force">['|', ('config_id.company_id', '=', False), ('config_id.company_id', 'in', company_ids)]</field>
    </record>

    <record id="pos_econique_transaction_company_rule" model="ir.rule">
        <field name="name">Econique Transaction: multi-company</field>
        <field name="model_id" ref="model_pos_econique_transaction"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
