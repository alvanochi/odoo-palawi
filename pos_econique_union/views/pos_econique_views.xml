<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ============ Econique config (one per POS config) ============ -->
    <record id="pos_econique_config_view_list" model="ir.ui.view">
        <field name="name">pos.econique.config.list</field>
        <field name="model">pos.econique.config</field>
        <field name="arch" type="xml">
            <list>
                <field name="pos_config_id"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="environment"/>
                <field name="base_url"/>
                <field name="tenant_code"/>
                <field name="tenant_name"/>
                <field name="auto_send" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="pos_econique_config_view_form" model="ir.ui.view">
        <field name="name">pos.econique.config.form</field>
        <field name="model">pos.econique.config</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_test_login" type="object" string="Test Login"
                            class="btn-primary" invisible="not id"/>
                    <button name="action_clear_token" type="object" string="Clear Token"
                            invisible="not id"
                            confirmation="The cached token will be removed. The next send logs in again."/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_transactions" type="object"
                                class="oe_stat_button" icon="fa-exchange" invisible="not id">
                            <field name="transaction_count" widget="statinfo" string="Transactions"/>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <field name="active" invisible="1"/>
                    <group>
                        <group string="POS">
                            <field name="pos_config_id" options="{'no_create': True}"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="auto_send" widget="boolean_toggle"/>
                        </group>
                        <group string="Tenant">
                            <field name="tenant_code"/>
                            <field name="tenant_name"/>
                        </group>
                        <group string="Connection">
                            <field name="environment"/>
                            <field name="base_url" widget="url"/>
                            <field name="username"/>
                            <field name="password" password="True"/>
                            <field name="token_date"/>
                        </group>
                        <group string="Sending">
                            <field name="api_version"/>
                            <field name="max_attempts"/>
                            <field name="timeout"/>
                            <field name="login_basic_auth"/>
                            <field name="basic_auth_user" invisible="not login_basic_auth"/>
                            <field name="basic_auth_password" password="True"
                                   invisible="not login_basic_auth"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Mapping Rules" name="mapping">
                            <group>
                                <group>
                                    <field name="invoice_source"/>
                                    <field name="product_code_source"/>
                                    <field name="service_fee_percent"/>
                                </group>
                                <group>
                                    <field name="price_from_pricelist"/>
                                    <field name="price_code" invisible="price_from_pricelist"/>
                                    <field name="price_name" invisible="price_from_pricelist"/>
                                    <field name="default_issuer"/>
                                    <field name="send_payment_vendor"/>
                                </group>
                            </group>
                        </page>
                        <page string="Payment Methods" name="payment_methods">
                            <field name="payment_map_ids">
                                <list editable="bottom">
                                    <field name="payment_method_id" options="{'no_create': True}"/>
                                    <field name="payment_type"/>
                                    <field name="payment_provider"/>
                                    <field name="payment_issuer"/>
                                </list>
                            </field>
                        </page>
                        <page string="Notes" name="notes">
                            <field name="note" placeholder="Internal notes (optional)..."/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="pos_econique_config_view_search" model="ir.ui.view">
        <field name="name">pos.econique.config.search</field>
        <field name="model">pos.econique.config</field>
        <field name="arch" type="xml">
            <search>
                <field name="pos_config_id"/>
                <field name="tenant_code"/>
                <field name="tenant_name"/>
                <filter name="auto_send_on" string="Auto Send On" domain="[('auto_send', '=', True)]"/>
                <filter name="archived" string="Archived" domain="[('active', '=', False)]"/>
                <group expand="0" string="Group By">
                    <filter name="group_environment" string="Environment" context="{'group_by': 'environment'}"/>
                    <filter name="group_company" string="Company" context="{'group_by': 'company_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="pos_econique_config_action" model="ir.actions.act_window">
        <field name="name">Econique Integration</field>
        <field name="res_model">pos.econique.config</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Set up the Econique integration for a POS config</p>
            <p>A POS config without an active Econique configuration sends nothing to Econique.</p>
        </field>
    </record>

    <!-- ============ Transactions ============ -->
    <record id="pos_econique_transaction_view_list" model="ir.ui.view">
        <field name="name">pos.econique.transaction.list</field>
        <field name="model">pos.econique.transaction</field>
        <field name="arch" type="xml">
            <list decoration-danger="state == 'failed'" decoration-success="state == 'sent'"
                  decoration-muted="state == 'skipped'" create="0">
                <field name="create_date" string="Created"/>
                <field name="invoice_number"/>
                <field name="pos_config_id"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="state" widget="badge"
                       decoration-danger="state == 'failed'" decoration-success="state == 'sent'"
                       decoration-warning="state == 'pending'"/>
                <field name="attempts"/>
                <field name="response_code"/>
                <field name="last_error" optional="show"/>
                <field name="sent_date" optional="show"/>
            </list>
        </field>
    </record>

    <record id="pos_econique_transaction_view_form" model="ir.ui.view">
        <field name="name">pos.econique.transaction.form</field>
        <field name="model">pos.econique.transaction</field>
        <field name="arch" type="xml">
            <form create="0">
                <header>
                    <button name="action_send_now" type="object" string="Send Now"
                            class="btn-primary" invisible="state not in ('pending', 'failed')"/>
                    <button name="action_reset" type="object" string="Reset to Pending"
                            invisible="state not in ('failed', 'skipped')"/>
                    <button name="action_skip" type="object" string="Skip"
                            invisible="state not in ('pending', 'failed')"
                            confirmation="This transaction will not be sent to Econique. Continue?"/>
                    <field name="state" widget="statusbar" statusbar_visible="pending,sent"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="order_id"/>
                            <field name="invoice_number"/>
                            <field name="econique_config_id"/>
                            <field name="pos_config_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group>
                            <field name="attempts"/>
                            <field name="next_attempt"/>
                            <field name="sent_date"/>
                            <field name="response_code"/>
                            <field name="remote_uuid"/>
                            <field name="total_netto"/>
                        </group>
                    </group>
                    <group invisible="not last_error">
                        <field name="last_error" nolabel="1" colspan="2"/>
                    </group>
                    <notebook>
                        <page string="Request" name="request">
                            <field name="request_payload"/>
                        </page>
                        <page string="Response" name="response">
                            <field name="response_payload"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="pos_econique_transaction_view_search" model="ir.ui.view">
        <field name="name">pos.econique.transaction.search</field>
        <field name="model">pos.econique.transaction</field>
        <field name="arch" type="xml">
            <search>
                <field name="invoice_number"/>
                <field name="order_id"/>
                <field name="pos_config_id"/>
                <filter name="pending" string="Pending" domain="[('state', '=', 'pending')]"/>
                <filter name="failed" string="Failed" domain="[('state', '=', 'failed')]"/>
                <filter name="sent" string="Sent" domain="[('state', '=', 'sent')]"/>
                <filter name="skipped" string="Skipped" domain="[('state', '=', 'skipped')]"/>
                <group expand="0" string="Group By">
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                    <filter name="group_pos" string="POS Config" context="{'group_by': 'pos_config_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="pos_econique_transaction_action" model="ir.actions.act_window">
        <field name="name">Econique Transactions</field>
        <field name="res_model">pos.econique.transaction</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_failed': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No Econique transactions yet</p>
            <p>Transactions appear here automatically when an order is paid in a POS that has an active Econique configuration.</p>
        </field>
    </record>

    <!-- ============ Menu ============ -->
    <menuitem id="pos_econique_config_menu"
              name="Econique Integration"
              parent="point_of_sale.menu_point_config_product"
              action="pos_econique_config_action"
              groups="group_pos_econique_manager"
              sequence="92"/>

    <menuitem id="pos_econique_transaction_menu"
              name="Econique Transactions"
              parent="point_of_sale.menu_point_config_product"
              action="pos_econique_transaction_action"
              groups="group_pos_econique_manager"
              sequence="93"/>
</odoo>
