<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <!-- Tree/List view debug -->
  <record id="view_pos_kitchen_order_tree_debug" model="ir.ui.view">
    <field name="name">pos.kitchen.order.tree.debug</field>
    <field name="model">pos.kitchen.order</field>
    <field name="arch" type="xml">
      <!-- Odoo 16+ menggunakan <list> (bukan <tree>) -->
      <list create="false" edit="false">
        <field name="create_date"/>
        <field name="pos_order_line_id"/>
        <field name="state"/>
        <field name="qty"/>
        <field name="product_id"/>
        <field name="note"/>
        <field name="is_latest_active"/>
        <field name="is_superseded"/>
      </list>
    </field>
  </record>

  <!-- Action -->
  <record id="action_pos_kitchen_order_debug" model="ir.actions.act_window">
    <field name="name">Kitchen Orders (Debug)</field>
    <field name="res_model">pos.kitchen.order</field>
    <field name="view_mode">list,form</field>
    <field name="view_id" ref="view_pos_kitchen_order_tree_debug"/>
    <field name="target">current</field>
  </record>

  <!-- Menu -->
  <menuitem id="menu_pos_kitchen_order_debug"
            name="Kitchen Orders (Debug)"
            parent="pos_kitchen_screen_odoo.menu_kitchen_screen_root"
            action="action_pos_kitchen_order_debug"
            sequence="90"/>
</odoo>
