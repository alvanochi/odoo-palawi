    </record>
    <!-- POS Managers manage flags too -->
    <record id="point_of_sale.group_pos_manager" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('pos_mobile_feature_flags.group_pos_mobile_flag_manager'))]"/>
    </record>
</odoo>
