<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="pos_mobile_config_flag_view_list" model="ir.ui.view">
        <field name="name">pos.mobile.config.flag.list</field>
        <field name="model">pos.mobile.config.flag</field>
        <field name="arch" type="xml">
            <list editable="bottom" create="0" delete="0"
                  decoration-warning="overridden" decoration-muted="not enabled">
                <field name="config_id" readonly="1"/>
                <field name="module_id" readonly="1"/>
                <field name="feature_id" readonly="1"/>
                <field name="key" readonly="1" optional="show"/>
                <field name="android_status" readonly="1" optional="hide"/>
                <field name="enabled" widget="boolean_toggle"/>
                <field name="default_enabled" readonly="1"/>
                <field name="overridden" column_invisible="True"/>
            </list>
        </field>
    </record>
    <record id="pos_mobile_config_flag_view_search" model="ir.ui.view">
        <field name="name">pos.mobile.config.flag.search</field>
        <field name="model">pos.mobile.config.flag</field>
        <field name="arch" type="xml">
            <search>
                <field name="config_id"/>
                <field name="feature_id"/>
                <field name="key"/>
                <filter name="on" string="Enabled" domain="[('enabled','=',True)]"/>
                <filter name="off" string="Disabled" domain="[('enabled','=',False)]"/>
                <filter name="overridden" string="Differs from plan" domain="[('overridden','=',True)]"/>
                <group expand="0" string="Group By">
                    <filter name="group_config" string="POS" context="{'group_by': 'config_id'}"/>
                    <filter name="group_module" string="Module" context="{'group_by': 'module_id'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="pos_mobile_config_flag_action" model="ir.actions.act_window">
        <field name="name">Flags per POS</field>
        <field name="res_model">pos.mobile.config.flag</field>
        <field name="view_mode">list</field>
        <field name="context">{'search_default_group_config': 1, 'search_default_group_module': 1}</field>
    </record>

    <record id="pos_mobile_config_module_view_list" model="ir.ui.view">
        <field name="name">pos.mobile.config.module.list</field>
        <field name="model">pos.mobile.config.module</field>
        <field name="arch" type="xml">
            <list editable="bottom" create="0" delete="0">
                <field name="module_id" readonly="1"/>
                <field name="master_key" readonly="1"/>
                <field name="enabled" widget="boolean_toggle"/>
            </list>
        </field>
    </record>
</odoo>
