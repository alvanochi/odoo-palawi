<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="pos_mobile_feature_view_list" model="ir.ui.view">
        <field name="name">pos.mobile.feature.list</field>
        <field name="model">pos.mobile.feature</field>
        <field name="arch" type="xml">
            <list>
                <field name="module_id"/>
                <field name="name"/>
                <field name="key"/>
                <field name="android_status" widget="badge"/>
                <field name="plan_lite"/>
                <field name="plan_medium"/>
                <field name="plan_enterprise"/>
                <field name="note" optional="show"/>
            </list>
        </field>
    </record>
    <record id="pos_mobile_feature_view_form" model="ir.ui.view">
        <field name="name">pos.mobile.feature.form</field>
        <field name="model">pos.mobile.feature</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <widget name="web_ribbon" title="Deprecated" bg_color="text-bg-danger" invisible="active"/>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="key" readonly="id"/>
                            <field name="module_id"/>
                            <field name="android_status"/>
                        </group>
                        <group string="Default per plan">
                            <field name="plan_lite"/>
                            <field name="plan_medium"/>
                            <field name="plan_enterprise"/>
                            <field name="sequence"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <field name="note" placeholder="Notes"/>
                </sheet>
            </form>
        </field>
    </record>
    <record id="pos_mobile_feature_view_search" model="ir.ui.view">
        <field name="name">pos.mobile.feature.search</field>
        <field name="model">pos.mobile.feature</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="key"/>
                <field name="module_id"/>
                <filter name="archived" string="Deprecated" domain="[('active','=',False)]"/>
                <group expand="0" string="Group By">
                    <filter name="group_module" string="Module" context="{'group_by': 'module_id'}"/>
                    <filter name="group_status" string="Android Status" context="{'group_by': 'android_status'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="pos_mobile_feature_action" model="ir.actions.act_window">
        <field name="name">Mobile Features</field>
        <field name="res_model">pos.mobile.feature</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_group_module': 1}</field>
    </record>
</odoo>
