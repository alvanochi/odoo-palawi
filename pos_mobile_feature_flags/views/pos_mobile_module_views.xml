<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="pos_mobile_module_view_list" model="ir.ui.view">
        <field name="name">pos.mobile.module.list</field>
        <field name="model">pos.mobile.module</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="master_key"/>
                <field name="feature_count"/>
                <field name="description"/>
                <field name="active" column_invisible="True"/>
            </list>
        </field>
    </record>
    <record id="pos_mobile_module_view_form" model="ir.ui.view">
        <field name="name">pos.mobile.module.form</field>
        <field name="model">pos.mobile.module</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="code"/>
                            <field name="master_key"/>
                        </group>
                        <group>
                            <field name="sequence"/>
                            <field name="description"/>
                            <field name="active" invisible="1"/>
                        </group>
                    </group>
                    <field name="feature_ids">
                        <list>
                            <field name="sequence" widget="handle"/>
                            <field name="name"/>
                            <field name="key"/>
                            <field name="android_status"/>
                            <field name="plan_lite"/>
                            <field name="plan_medium"/>
                            <field name="plan_enterprise"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>
    <record id="pos_mobile_module_action" model="ir.actions.act_window">
        <field name="name">Mobile Modules</field>
        <field name="res_model">pos.mobile.module</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
