<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>

        <!-- ACTION -->
        <record id="action_pos_owner_dashboard" model="ir.actions.act_window">
            <field name="name">POS Owner Dashboard</field>
            <field name="res_model">pos.owner.dashboard</field>
            <field name="view_mode">form</field>
            <field name="context">{'create': True}</field>
            <field name="target">current</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Dashboard untuk Owner Restoran
                </p>
            </field>
        </record>

        <!-- MENU DASHBOARD OWNER - Inside Point of Sale -->
        <menuitem id="menu_pos_owner_dashboard"
                  name="Dashboard Owner"
                  parent="point_of_sale.menu_point_root"
                  action="action_pos_owner_dashboard"
                  sequence="5"
                  groups="point_of_sale.group_pos_manager,point_of_sale.group_pos_user"/>

        <!-- FORM VIEW -->
        <record id="view_pos_owner_dashboard_form" model="ir.ui.view">
            <field name="name">pos.owner.dashboard.form</field>
            <field name="model">pos.owner.dashboard</field>
            <field name="arch" type="xml">
                <form string="POS Owner Dashboard" create="1" edit="1">
                    <header>
                        <button name="action_export_excel" string="Export Excel" type="object" class="btn-primary"/>
                    </header>
                    <sheet>
                        <!-- FILTERS -->
                        <group>
                            <group>
                                <field name="name" invisible="1"/>
                                <field name="currency_id" invisible="1"/>
                                <field name="date_from"/>
                                <field name="date_to"/>
                            </group>
                            <group>
                                <field name="pos_config_id" 
                                       placeholder="Semua POS"
                                       domain="[('company_id', 'in', allowed_company_ids)]"
                                       options="{'no_create': True}"/>
                                <!-- <field name="pos_session_id" 
                                       placeholder="Semua Sesi / Shift"
                                       options="{'no_create': True}"/> -->
                            </group>
                        </group>

                        <notebook>
                            <!-- Main Dashboard Tab -->
                            <page string="Dashboard" name="dashboard">
                                <field name="dashboard_html" widget="html" nolabel="1"/>
                            </page>

                            <!-- Top Products Tab -->
                            <page string="Produk Terlaris" name="top_products">
                                <group>
                                    <group>
                                        <field name="page_size_products" widget="radio" options="{'horizontal': true}"/>
                                    </group>
                                </group>
                                <field name="top_products_html" widget="html" nolabel="1"/>
                            </page>

                            <!-- Hourly Orders Tab -->
                            <page string="Order per Jam" name="hourly_orders">
                                <field name="hourly_orders_html" widget="html" nolabel="1"/>
                            </page>

                            <!-- Payment Methods Tab -->
                            <page string="Metode Pembayaran" name="payment_methods">
                                <field name="payment_methods_html" widget="html" nolabel="1"/>
                            </page>

                            <!-- Cashier Performance Tab -->
                            <page string="Performa Kasir" name="cashier_performance">
                                <field name="cashier_performance_html" widget="html" nolabel="1"/>
                            </page>

                            <!-- Transaction List Tab -->
                            <page string="Daftar Transaksi" name="transaction_list">
                                <group>
                                    <group>
                                        <field name="status_filter" widget="radio" options="{'horizontal': true}"/>
                                    </group>
                                    <group>
                                        <field name="page_size_transactions" widget="radio" options="{'horizontal': true}"/>
                                    </group>
                                </group>
                                <field name="transaction_list_html" widget="html" nolabel="1"/>
                            </page>

                            <!-- Bills Tab -->
                            <page string="Bills" name="bills">
                                <group>
                                    <group>
                                        <field name="page_size_bills" widget="radio" options="{'horizontal': true}"/>
                                    </group>
                                </group>
                                <field name="bills_html" widget="html" nolabel="1"/>
                            </page>

                            <!-- Cash In/Out Tab -->
                            <page string="Cash In/Out" name="cash_movement">
                                <group>
                                    <group>
                                        <field name="page_size_cash" widget="radio" options="{'horizontal': true}"/>
                                    </group>
                                </group>
                                <field name="cash_movement_html" widget="html" nolabel="1"/>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- LIST VIEW -->
        <record id="view_pos_owner_dashboard_tree" model="ir.ui.view">
            <field name="name">pos.owner.dashboard.tree</field>
            <field name="model">pos.owner.dashboard</field>
            <field name="arch" type="xml">
                <list string="POS Owner Dashboard">
                    <field name="name"/>
                    <field name="date_from"/>
                    <field name="date_to"/>
                    <field name="pos_config_id"/>
                    <field name="total_orders"/>
                    <field name="total_sales"/>
                </list>
            </field>
        </record>

    </data>
</odoo>
