<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ============ Credential ============ -->
    <record id="pos_payment_gateway_credential_view_list" model="ir.ui.view">
        <field name="name">pos.payment.gateway.credential.list</field>
        <field name="model">pos.payment.gateway.credential</field>
        <field name="arch" type="xml">
            <list>
                <field name="pos_config_id"/>
                <field name="gateway_id"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="base_url"/>
                <field name="client_id"/>
                <field name="write_date" string="Last Updated"/>
            </list>
        </field>
    </record>

    <record id="pos_payment_gateway_credential_view_form" model="ir.ui.view">
        <field name="name">pos.payment.gateway.credential.form</field>
        <field name="model">pos.payment.gateway.credential</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <field name="active" invisible="1"/>
                    <group>
                        <group string="POS">
                            <field name="pos_config_id" options="{'no_create': True}"/>
                            <field name="gateway_id" options="{'no_create': True}"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group string="Credential">
                            <field name="base_url" widget="url"/>
                            <field name="client_id"/>
                            <field name="client_secret" password="True"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Extra Parameters" name="extra_params">
                            <field name="extra_param_ids">
                                <list editable="bottom">
                                    <field name="key"/>
                                    <field name="value"/>
                                </list>
                            </field>
                        </page>
                        <page string="Notes" name="notes">
                            <field name="note" placeholder="Catatan internal (opsional)..."/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="pos_payment_gateway_credential_view_search" model="ir.ui.view">
        <field name="name">pos.payment.gateway.credential.search</field>
        <field name="model">pos.payment.gateway.credential</field>
        <field name="arch" type="xml">
            <search>
                <field name="pos_config_id"/>
                <field name="gateway_id"/>
                <field name="client_id"/>
                <filter name="archived" string="Archived" domain="[('active', '=', False)]"/>
                <group expand="0" string="Group By">
                    <filter name="group_gateway" string="Payment Gateway" context="{'group_by': 'gateway_id'}"/>
                    <filter name="group_pos" string="POS Config" context="{'group_by': 'pos_config_id'}"/>
                    <filter name="group_company" string="Company" context="{'group_by': 'company_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="pos_payment_gateway_credential_action" model="ir.actions.act_window">
        <field name="name">Payment Gateway Credentials</field>
        <field name="res_model">pos.payment.gateway.credential</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Tambah credential payment gateway untuk POS config</p>
            <p>Satu POS config bisa punya beberapa gateway, tapi hanya satu credential aktif per gateway.</p>
        </field>
    </record>

    <!-- ============ Gateway master ============ -->
    <record id="pos_payment_gateway_view_list" model="ir.ui.view">
        <field name="name">pos.payment.gateway.list</field>
        <field name="model">pos.payment.gateway</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="default_base_url"/>
            </list>
        </field>
    </record>

    <record id="pos_payment_gateway_view_form" model="ir.ui.view">
        <field name="name">pos.payment.gateway.form</field>
        <field name="model">pos.payment.gateway</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_credentials" type="object"
                                class="oe_stat_button" icon="fa-key">
                            <field name="credential_count" widget="statinfo" string="Credentials"/>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <field name="active" invisible="1"/>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="code"/>
                        </group>
                        <group>
                            <field name="default_base_url" widget="url"/>
                            <field name="sequence"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="pos_payment_gateway_action" model="ir.actions.act_window">
        <field name="name">Payment Gateways</field>
        <field name="res_model">pos.payment.gateway</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- ============ Menu ============ -->
    <menuitem id="pos_payment_gateway_credential_menu"
              name="Payment Gateway Credentials"
              parent="point_of_sale.menu_point_config_product"
              action="pos_payment_gateway_credential_action"
              groups="group_pos_payment_gateway_manager"
              sequence="90"/>

    <menuitem id="pos_payment_gateway_menu"
              name="Payment Gateways"
              parent="point_of_sale.menu_point_config_product"
              action="pos_payment_gateway_action"
              groups="group_pos_payment_gateway_manager"
              sequence="91"/>
</odoo>
