<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Wizard -->
    <record id="pos_tenant_report_wizard_view_form" model="ir.ui.view">
        <field name="name">pos.tenant.report.wizard.form</field>
        <field name="model">pos.tenant.report.wizard</field>
        <field name="arch" type="xml">
            <form string="Laporan Transaksi Tenant">
                <group>
                    <group string="Periode">
                        <field name="date_from"/>
                        <field name="date_to"/>
                    </group>
                    <group string="Filter">
                        <field name="company_ids" widget="many2many_tags"
                               options="{'no_create': True}"/>
                        <field name="config_ids" widget="many2many_tags"
                               domain="[('company_id', 'in', company_ids)]"
                               options="{'no_create': True}"/>
                    </group>
                </group>
                <group>
                    <field name="handling_product_ids" widget="many2many_tags"
                           options="{'no_create': True}"/>
                </group>
                <div class="text-muted">
                    Pajak diambil dari Taxes Odoo di tiap baris order: nama berisi
                    "PBJT"/"PB1" masuk kolom Tax/PB1, nama berisi "PNBP" masuk kolom Pnbp.
                </div>
                <footer>
                    <button name="action_view_lines" type="object"
                            string="Lihat di Odoo" class="btn-primary"/>
                    <button name="action_export_xlsx" type="object"
                            string="Download Excel" class="btn-secondary"/>
                    <button string="Batal" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="pos_tenant_report_wizard_action" model="ir.actions.act_window">
        <field name="name">Laporan Transaksi Tenant</field>
        <field name="res_model">pos.tenant.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <!-- Result lines -->
    <record id="pos_tenant_report_line_view_list" model="ir.ui.view">
        <field name="name">pos.tenant.report.line.list</field>
        <field name="model">pos.tenant.report.line</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0">
                <header>
                    <button name="action_export_xlsx" type="object"
                            string="Download Excel" display="always"/>
                </header>
                <field name="currency_id" column_invisible="1"/>
                <field name="sequence"/>
                <field name="klaster" optional="show"/>
                <field name="lokasi" optional="show"/>
                <field name="tenant"/>
                <field name="kasir" optional="show"/>
                <field name="customer" optional="show"/>
                <field name="no_transaksi"/>
                <field name="tanggal_transaksi"/>
                <field name="waktu" optional="show"/>
                <field name="jenis_pembayaran"/>
                <field name="total_kotor" sum="Total"/>
                <field name="diskon" sum="Total" optional="show"/>
                <field name="biaya_penanganan" sum="Total" optional="show"/>
                <field name="pb1" sum="Total"/>
                <field name="pnbp" sum="Total"/>
                <field name="pajak" sum="Total"/>
                <field name="pendapatan" sum="Total"/>
                <field name="tanggal_pembayaran" optional="show"/>
                <field name="pendapatan_minus_pb1" sum="Total" optional="show"/>
                <field name="netto" sum="Total"/>
                <field name="amount_paid" sum="Total" optional="show"/>
                <field name="selisih" sum="Total" optional="show"
                       decoration-danger="selisih != 0"/>
                <field name="order_id" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="pos_tenant_report_line_view_search" model="ir.ui.view">
        <field name="name">pos.tenant.report.line.search</field>
        <field name="model">pos.tenant.report.line</field>
        <field name="arch" type="xml">
            <search>
                <field name="tenant"/>
                <field name="kasir"/>
                <field name="customer"/>
                <field name="no_transaksi"/>
                <field name="jenis_pembayaran"/>
                <group expand="0" string="Group By">
                    <filter name="group_klaster" string="Klaster" context="{'group_by': 'klaster'}"/>
                    <filter name="group_lokasi" string="Lokasi" context="{'group_by': 'lokasi'}"/>
                    <filter name="group_tenant" string="Tenant" context="{'group_by': 'tenant'}"/>
                    <filter name="group_kasir" string="Kasir" context="{'group_by': 'kasir'}"/>
                    <filter name="group_payment" string="Jenis Pembayaran" context="{'group_by': 'jenis_pembayaran'}"/>
                    <filter name="group_date" string="Tanggal Transaksi" context="{'group_by': 'tanggal_transaksi:day'}"/>
                </group>
            </search>
        </field>
    </record>

    <menuitem id="pos_tenant_report_menu"
              name="Laporan Transaksi Tenant"
              parent="point_of_sale.menu_point_rep"
              action="pos_tenant_report_wizard_action"
              groups="point_of_sale.group_pos_manager"
              sequence="50"/>
</odoo>
