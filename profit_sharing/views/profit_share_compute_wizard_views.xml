<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_profit_share_compute_wizard_form" model="ir.ui.view">
        <field name="name">profit.share.compute.wizard.form</field>
        <field name="model">profit.share.compute.wizard</field>
        <field name="arch" type="xml">
            <form string="Calculate Profit Sharing">
                <group>
                    <field name="company_id"/>
                    <field name="period_type"/>
                    <field name="date_from"/>
                    <field name="date_to"/>
                </group>
                <footer>
                    <button name="action_compute" type="object" string="Calculate" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_profit_share_compute_wizard" model="ir.actions.act_window">
        <field name="name">Calculate Profit Sharing</field>
        <field name="res_model">profit.share.compute.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
