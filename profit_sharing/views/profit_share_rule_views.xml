<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_profit_share_rule_search" model="ir.ui.view">
        <field name="name">profit.share.rule.search</field>
        <field name="model">profit.share.rule</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="recipient_id"/>
                <field name="share_type_id"/>
                <field name="company_id"/>
                <filter string="Confirmed" name="confirmed" domain="[('state','=','confirmed')]"/>
                <filter string="POS Revenue" name="pos_revenue" domain="[('source_type','=','pos_revenue')]"/>
                <filter string="Net Profit" name="net_profit" domain="[('source_type','=','net_profit')]"/>
                <group expand="0" string="Group By">
                    <filter string="Company" name="group_company" context="{'group_by':'company_id'}"/>
                    <filter string="Share Type" name="group_share_type" context="{'group_by':'share_type_id'}"/>
                    <filter string="Recipient" name="group_recipient" context="{'group_by':'recipient_id'}"/>
                    <filter string="Source" name="group_source" context="{'group_by':'source_type'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_profit_share_rule_list" model="ir.ui.view">
        <field name="name">profit.share.rule.list</field>
        <field name="model">profit.share.rule</field>
        <field name="arch" type="xml">
            <list decoration-success="state == 'confirmed'" decoration-muted="state == 'archived'" default_order="priority desc,id asc">
                <field name="priority"/>
                <field name="name"/>
                <field name="share_type_id"/>
                <field name="recipient_id"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="computation_type"/>
                <field name="percentage" invisible="computation_type != 'percentage'"/>
                <field name="flat_amount" invisible="computation_type != 'flat'"/>
                <field name="source_type"/>
                <field name="period_type"/>
                <field name="date_start" optional="hide"/>
                <field name="date_end" optional="hide"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_profit_share_rule_form" model="ir.ui.view">
        <field name="name">profit.share.rule.form</field>
        <field name="model">profit.share.rule</field>
        <field name="arch" type="xml">
            <form string="Profit Sharing Rule">
                <header>
                    <button name="action_confirm" type="object" string="Confirm" class="btn-primary" invisible="state != 'draft'" groups="profit_sharing.group_profit_share_manager"/>
                    <button name="action_set_draft" type="object" string="Set to Draft" invisible="state not in ['confirmed','archived']" groups="profit_sharing.group_profit_share_manager"/>
                    <button name="action_archive" type="object" string="Archive" invisible="state not in ['draft','confirmed']" groups="profit_sharing.group_profit_share_manager"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,confirmed,archived"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. Partner A Fee — Sudirman Store Revenue"/></h1>
                    </div>
                    <group>
                        <group string="Recipient &amp; Scheme">
                            <field name="company_id" options="{'no_create': True}"/>
                            <field name="share_type_id"/>
                            <field name="recipient_id"/>
                            <field name="computation_type"/>
                            <field name="percentage" invisible="computation_type != 'percentage'"/>
                            <field name="flat_amount" invisible="computation_type != 'flat'"/>
                        </group>
                        <group string="Validity &amp; Priority">
                            <field name="period_type"/>
                            <field name="date_start"/>
                            <field name="date_end"/>
                            <field name="priority"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>
                    <group string="Calculation Source">
                        <field name="source_type"/>
                        <field name="pos_config_ids" widget="many2many_tags" domain="[('company_id', '=', company_id)]" invisible="source_type != 'pos_revenue'"/>
                        <field name="pos_category_ids" widget="many2many_tags" invisible="source_type != 'pos_revenue'"/>
                        <field name="analytic_account_ids" widget="many2many_tags" invisible="source_type != 'net_profit'"/>
                        <field name="journal_ids" widget="many2many_tags" domain="[('company_id', '=', company_id)]" invisible="source_type != 'net_profit'"/>
                    </group>
                    <group string="Notes">
                        <field name="notes" nolabel="1" placeholder="Agreement basis, contract reference, or other notes..."/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_profit_share_rule" model="ir.actions.act_window">
        <field name="name">Sharing Rules</field>
        <field name="res_model">profit.share.rule</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_profit_share_rule_search"/>
        <field name="context">{'search_default_confirmed': 1}</field>
    </record>
</odoo>
