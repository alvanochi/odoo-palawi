<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_profit_share_type_list" model="ir.ui.view">
        <field name="name">profit.share.type.list</field>
        <field name="model">profit.share.type</field>
        <field name="arch" type="xml">
            <list default_order="sequence,name">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="color" widget="color_picker" optional="hide"/>
                <field name="active" optional="show"/>
            </list>
        </field>
    </record>

    <record id="view_profit_share_type_form" model="ir.ui.view">
        <field name="name">profit.share.type.form</field>
        <field name="model">profit.share.type</field>
        <field name="arch" type="xml">
            <form string="Share Type">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="code"/>
                        <field name="sequence"/>
                        <field name="color" widget="color_picker"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_profit_share_type" model="ir.actions.act_window">
        <field name="name">Share Types</field>
        <field name="res_model">profit.share.type</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
