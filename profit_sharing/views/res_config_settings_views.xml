<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Upgrade compatibility cleanup.

        Versions <= 18.0.1.0.5 used this XML ID as an inherited
        res.config.settings extension.  On an upgrade, simply omitting
        inherit_id does not clear the value already stored in ir.ui.view,
        so Odoo would continue interpreting a full <form> arch as an
        inheritance specification and fail with:

            Element '<form ...>' cannot be located in parent view

        Explicitly clear the old inheritance and deactivate this legacy view.
        Profit Sharing settings are now handled by a dedicated transient model
        below, which also prevents unrelated/broken global Settings extensions
        from blocking this module.
    -->
    <record id="res_config_settings_view_form_profit_sharing" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.profit.sharing.legacy.disabled</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" eval="False"/>
        <field name="mode">primary</field>
        <field name="active" eval="False"/>
        <field name="arch" type="xml">
            <form string="Profit Sharing Legacy Settings View"/>
        </field>
    </record>

    <record id="profit_share_settings_view_form" model="ir.ui.view">
        <field name="name">profit.share.settings.view.form</field>
        <field name="model">profit.share.settings</field>
        <field name="arch" type="xml">
            <form string="Profit Sharing Settings" create="0" delete="0">
                <sheet>
                    <div class="oe_title">
                        <h1>Profit Sharing Settings</h1>
                    </div>
                    <group string="Workflow">
                        <field name="approval_enabled"
                               help="When enabled, confirmed computation batches must be approved before they can be marked as paid."/>
                        <field name="negative_policy"
                               help="Choose how percentage-based sharing behaves when accounting net profit is negative."/>
                    </group>
                </sheet>
                <footer>
                    <button string="Save" name="action_save" type="object" class="btn-primary"/>
                    <button string="Discard" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_profit_share_settings" model="ir.actions.act_window">
        <field name="name">Profit Sharing Settings</field>
        <field name="res_model">profit.share.settings</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="profit_sharing.profit_share_settings_view_form"/>
        <field name="target">new</field>
        <field name="context">{}</field>
    </record>
</odoo>
