<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- POS Cash Movement Tree View -->
    <record id="view_pos_cash_movement_tree" model="ir.ui.view">
        <field name="name">pos.cash.movement.tree</field>
        <field name="model">pos.cash.movement</field>
        <field name="arch" type="xml">
            <list string="Cash Movements" create="0" decoration-success="movement_type == 'cash_in'" decoration-danger="movement_type == 'cash_out'">
                <field name="name" decoration-bf="1"/>
                <field name="movement_time"/>
                <field name="pos_name"/>
                <field name="session_id"/>
                <field name="movement_type" widget="badge" decoration-success="movement_type == 'cash_in'" decoration-danger="movement_type == 'cash_out'"/>
                <field name="amount" sum="Total Amount"/>
                <field name="reason"/>
                <field name="user_name"/>
            </list>
        </field>
    </record>

    <!-- POS Cash Movement Form View -->
    <record id="view_pos_cash_movement_form" model="ir.ui.view">
        <field name="name">pos.cash.movement.form</field>
        <field name="model">pos.cash.movement</field>
        <field name="arch" type="xml">
            <form string="Cash Movement" create="0" edit="0">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Cash Movement ID"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Movement Info">
                            <field name="movement_type"/>
                            <field name="amount"/>
                            <field name="reason"/>
                        </group>
                        <group string="POS Info">
                            <field name="pos_name"/>
                            <field name="session_id"/>
                            <field name="user_name"/>
                            <field name="movement_time"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- POS Cash Movement Search View -->
    <record id="view_pos_cash_movement_search" model="ir.ui.view">
        <field name="name">pos.cash.movement.search</field>
        <field name="model">pos.cash.movement</field>
        <field name="arch" type="xml">
            <search string="Search Cash Movements">
                <field name="name"/>
                <field name="pos_name"/>
                <field name="session_id"/>
                <field name="reason"/>
                <filter string="Cash In" name="cash_in" domain="[('movement_type', '=', 'cash_in')]"/>
                <filter string="Cash Out" name="cash_out" domain="[('movement_type', '=', 'cash_out')]"/>
                <separator/>
                <filter string="Today" name="today" domain="[('movement_time', '&gt;=', (context_today()).strftime('%Y-%m-%d')), ('movement_time', '&lt;', (context_today() + datetime.timedelta(days=1)).strftime('%Y-%m-%d'))]"/>
                <separator/>
                <group expand="0" string="Group By">
                    <filter string="Type" name="type" domain="[]" context="{'group_by': 'movement_type'}"/>
                    <filter string="POS" name="pos" domain="[]" context="{'group_by': 'pos_name'}"/>
                    <filter string="Session" name="session" domain="[]" context="{'group_by': 'session_id'}"/>
                    <filter string="Date" name="date" domain="[]" context="{'group_by': 'movement_time:day'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- POS Cash Movement Action -->
    <record id="action_pos_cash_movement" model="ir.actions.act_window">
        <field name="name">Cash In/Out</field>
        <field name="res_model">pos.cash.movement</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_empty_folder">
                No cash movements found
            </p><p>
                Cash in/out movements from POS will appear here.
            </p>
        </field>
    </record>

    <!-- Menu Item under Point of Sale > Orders (below Bills) -->
    <menuitem 
        id="menu_pos_cash_movement" 
        name="Cash In/Out" 
        parent="point_of_sale.menu_point_of_sale" 
        action="action_pos_cash_movement" 
        sequence="6" 
        groups="point_of_sale.group_pos_manager,point_of_sale.group_pos_user"/>

</odoo>
