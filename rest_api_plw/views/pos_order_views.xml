<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_pos_pos_form_evidence" model="ir.ui.view">
        <field name="name">pos.order.form.evidence</field>
        <field name="model">pos.order</field>
        <field name="inherit_id" ref="point_of_sale.view_pos_pos_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Payment Evidence" name="payment_evidence">
                    <group>
                        <field name="evidence" widget="image" options="{'size': [250, 250]}"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
