<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Product category form: checkbox dapur ditaruh tepat di bawah Parent
         Category. Satu pengaturan di sini berlaku untuk semua produk di
         kategori tersebut. -->
    <record id="product_category_form_view_is_kitchen" model="ir.ui.view">
        <field name="name">product.category.form.is.kitchen</field>
        <field name="model">product.category</field>
        <field name="inherit_id" ref="product.product_category_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='first']/field[@name='parent_id']" position="after">
                <field name="is_kitchen"/>
            </xpath>
        </field>
    </record>

    <!-- Product category list: kolom opsional, tersembunyi secara default -->
    <record id="product_category_list_view_is_kitchen" model="ir.ui.view">
        <field name="name">product.category.list.is.kitchen</field>
        <field name="model">product.category</field>
        <field name="inherit_id" ref="product.product_category_list_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='display_name']" position="after">
                <field name="is_kitchen" optional="show"/>
            </xpath>
        </field>
    </record>

</odoo>
