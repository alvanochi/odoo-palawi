<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_company_form_inherit_plw" model="ir.ui.view">
        <field name="name">res.company.form.inherit.plw</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='parent_id']" position="after">
                <field name="head_user_id" options="{'no_create': True, 'no_open': True}"/>
            </xpath>
        </field>
    </record>
</odoo>
